#!/usr/bin/env bash
# heavy: admission control for heavy commands (Todd, 2026-11-19).
# Usage: heavy <command> [args...]   |   heavy --status
# Fills the machine up to HEAVY_MAX_CPU % CPU (default 90) and HEAVY_MAX_MEM % RAM (default 90), and keeps the
# 1-minute load below HEAVY_MAX_LOAD (default: 2 x number of CPUs). The load check is the crash guard: CPU % saturates
# at 100 while load keeps climbing (macOS load reads high even at moderate CPU, hence 2x). There is no cap on the
# number of jobs. HEAVY_RAMP seconds (default 20) must pass between admissions so the last job shows up in the
# measurements. The resource checks must pass twice in a row, HEAVY_CONFIRM seconds (default 10) apart, so a running
# build that briefly dips to one thread does not fool them. Only finite builds, tests and lint belong here, never servers or watchers.
# Admission is checked under a short mutex (a mkdir); the command itself runs outside it, registered in HEAVY_DIR.
# A metric that cannot be read is an error (exit 3). Integer math only (macOS bash 3.2).
set -u
dir=${HEAVY_DIR:-/tmp/heavy.d}          # job registry; overrides here and below are for tests only
admit=${HEAVY_ADMIT:-/tmp/heavy.admit}  # admission mutex
stamp=${HEAVY_STAMP:-/tmp/heavy.last}   # time of the last admission
reap=$admit.reap
max_cpu=${HEAVY_MAX_CPU:-90}
max_mem=${HEAVY_MAX_MEM:-90}
ramp=${HEAVY_RAMP:-20}
confirm=${HEAVY_CONFIRM:-10}

fail() { echo "heavy: $*" >&2; exit 3; }
alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
now() { date +%s; }
age() { echo $(( $(now) - $(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || now) )); }
isint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

ncpu() {
  local n; n=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null)
  isint "$n" && [ "$n" -gt 0 ] || fail "cannot read the number of CPUs"
  echo "$n"
}

load1() {
  local l
  if [ -r /proc/loadavg ]; then l=$(awk '{print int($1)}' /proc/loadavg)
  else l=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print int($2)}'); fi
  isint "$l" || fail "cannot read the load average"
  echo "$l"
}

# CPU busy %, sampled over about a second.
cpu_busy() {
  local b
  if [ -r /proc/stat ]; then
    local a1 a2
    a1=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8+$9, $5+$6}' /proc/stat); sleep 1
    a2=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8+$9, $5+$6}' /proc/stat)
    b=$(echo "$a1 $a2" | awk '{t=$3-$1; i=$4-$2; if (t>0) print int(100-(i*100)/t+0.99); else print "x"}')
  else
    # second sample of top is the live one; round busy up
    b=$(top -l 2 -n 0 -s 1 2>/dev/null | awk '/^CPU usage:/{l=$0} END{ if (match(l,/[0-9.]+% idle/)) { s=substr(l,RSTART,RLENGTH); sub(/%.*/,"",s); print int(100-s+0.99) } }')
  fi
  isint "$b" || fail "cannot read CPU usage"
  [ "$b" -gt 100 ] && b=100
  echo "$b"
}

# Memory used %.
mem_used() {
  local u
  if [ -r /proc/meminfo ]; then
    u=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{ if (t>0 && a!="") print int(100-(a*100)/t+0.99) }' /proc/meminfo)
  else
    u=$(memory_pressure 2>/dev/null | awk '/System-wide memory free percentage:/{f=$NF; sub(/%/,"",f); print int(100-f)}')
  fi
  isint "$u" || fail "cannot read memory usage"
  echo "$u"
}

# Drop registrations of dead pids, then print the rest as "pid age cwd command".
status() {
  local f p n=0 line cwd
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    p=${f##*/}
    isint "$p" || continue
    if ! alive "$p"; then rm -f "$f"; continue; fi
    line=$(sed -n 1p "$f"); cwd=$(sed -n 2p "$f")
    echo "pid $p  age $(age "$f")s  $cwd  $line"; n=$((n + 1))
  done
  echo "running: $n"
  echo "cpu $(cpu_busy)% (max $max_cpu)  mem $(mem_used)% (max $max_mem)  load $(load1) (max ${HEAVY_MAX_LOAD:-$(( $(ncpu) * 2 ))})"
}

case "${1:-}" in
  --status) status; exit 0 ;;
  ''|-h|--help) echo "usage: heavy <command> [args...] | heavy --status" >&2; exit 2 ;;
esac

# Nested call (a heavy Makefile target run under heavy): pass through if the holder is a live registered job.
if [ -n "${HEAVY_HELD:-}" ] && [ -f "$dir/$HEAVY_HELD" ] && alive "$HEAVY_HELD"; then exec "$@"; fi

load_max=${HEAVY_MAX_LOAD:-$(( $(ncpu) * 2 ))}
isint "$max_cpu" && isint "$max_mem" && isint "$ramp" && isint "$confirm" && isint "$load_max" || fail "thresholds must be integers"
mkdir -p "$dir" || fail "cannot create $dir"

holder() { cat "$admit/pid" 2>/dev/null || true; }
have_admit=0

cleanup() {
  [ "$have_admit" = 1 ] && [ "$(holder)" = "$$" ] && rm -rf "$admit"
  rm -f "$dir/$$"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Reclaim a stale admission mutex. The reap mutex makes check-and-remove atomic.
reclaim() {
  if mkdir "$reap" 2>/dev/null; then
    local h; h=$(holder)
    if [ -d "$admit" ]; then
      if [ -n "$h" ]; then
        alive "$h" || { [ "$(holder)" = "$h" ] && mv "$admit" "$admit.stale.$$" 2>/dev/null && rm -rf "$admit.stale.$$"; }
      elif [ "$(age "$admit")" -ge 10 ] && [ -z "$(holder)" ]; then
        # taken 10 s ago and never got a pid: its taker died
        mv "$admit" "$admit.stale.$$" 2>/dev/null && rm -rf "$admit.stale.$$"
      fi
    fi
    rm -rf "$reap"
  elif [ "$(age "$reap")" -ge 30 ]; then
    # a reaper died mid-reclaim: rename atomically, only the one whose mv succeeds removes it
    mv "$reap" "$reap.stale.$$" 2>/dev/null && rm -rf "$reap.stale.$$"
  fi
}

# One resource sample. Sets $reason and returns 1 when the machine is too busy.
sample() {
  local c m l
  c=$(cpu_busy) || exit 3
  [ "$c" -lt "$max_cpu" ] || { reason="cpu ${c}% >= ${max_cpu}%"; return 1; }
  m=$(mem_used) || exit 3
  [ "$m" -lt "$max_mem" ] || { reason="memory ${m}% >= ${max_mem}%"; return 1; }
  l=$(load1) || exit 3
  [ "$l" -lt "$load_max" ] || { reason="load ${l} >= ${load_max}"; return 1; }
  return 0
}

# Called holding the admit mutex. Sets $reason and returns 1 when the machine is too busy: ramp spacing, then two
# passing samples $confirm seconds apart.
check() {
  local last t
  nap=5
  last=0; [ -f "$stamp" ] && last=$(cat "$stamp" 2>/dev/null); isint "$last" || last=0
  t=$(now); [ "$last" -gt "$t" ] && last=0   # a stamp from the future (clock change) counts as none
  if [ $(( t - last )) -lt "$ramp" ]; then
    reason="ramp spacing (under ${ramp}s since last start)"
    nap=$(( ramp - (t - last) )); [ "$nap" -gt 5 ] && nap=5; [ "$nap" -lt 1 ] && nap=1
    return 1
  fi
  sample || return 1
  sleep "$confirm"   # the mutex stays held, so no other admission slips in between the samples
  sample || { reason="$reason (second sample)"; return 1; }
  return 0
}

said=""
while :; do
  reason=""
  if mkdir "$admit" 2>/dev/null; then
    have_admit=1
    echo $$ > "$admit/pid" || { have_admit=0; continue; }
    if check; then
      now > "$stamp"
      printf '%s\n%s\n' "$*" "$PWD" > "$dir/$$"
      rm -rf "$admit"; have_admit=0
      break
    fi
    rm -rf "$admit"; have_admit=0
  else
    reason="admission busy"; nap=5
    reclaim
  fi
  key=${reason%% [0-9]*}
  [ "$said" = "$key" ] || { echo "heavy: waiting ($reason)" >&2; said=$key; }
  sleep "${nap:-5}"   # retry on a busy shared resource, not polling for data
done

HEAVY_HELD=$$ "$@"
